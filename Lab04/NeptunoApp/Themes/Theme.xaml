<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Paleta ===================== -->
    <Color x:Key="FondoColor">#F4F5F7</Color>
    <Color x:Key="SuperficieColor">#FFFFFF</Color>
    <Color x:Key="SuperficieAlternaColor">#FAFBFC</Color>
    <Color x:Key="BordeColor">#DFE3E8</Color>
    <Color x:Key="AcentoColor">#2D6A9F</Color>
    <Color x:Key="AcentoHoverColor">#3A7FB8</Color>
    <Color x:Key="AcentoSuaveColor">#E8F0F6</Color>
    <Color x:Key="TextoPrimarioColor">#1F2328</Color>
    <Color x:Key="TextoSecundarioColor">#6B7280</Color>
    <Color x:Key="PeligroColor">#C0392B</Color>
    <Color x:Key="ExitoColor">#1A7F5A</Color>

    <SolidColorBrush x:Key="FondoBrush" Color="{StaticResource FondoColor}"/>
    <SolidColorBrush x:Key="SuperficieBrush" Color="{StaticResource SuperficieColor}"/>
    <SolidColorBrush x:Key="SuperficieAlternaBrush" Color="{StaticResource SuperficieAlternaColor}"/>
    <SolidColorBrush x:Key="BordeBrush" Color="{StaticResource BordeColor}"/>
    <SolidColorBrush x:Key="AcentoBrush" Color="{StaticResource AcentoColor}"/>
    <SolidColorBrush x:Key="AcentoHoverBrush" Color="{StaticResource AcentoHoverColor}"/>
    <SolidColorBrush x:Key="AcentoSuaveBrush" Color="{StaticResource AcentoSuaveColor}"/>
    <SolidColorBrush x:Key="TextoPrimarioBrush" Color="{StaticResource TextoPrimarioColor}"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="{StaticResource TextoSecundarioColor}"/>
    <SolidColorBrush x:Key="PeligroBrush" Color="{StaticResource PeligroColor}"/>
    <SolidColorBrush x:Key="ExitoBrush" Color="{StaticResource ExitoColor}"/>

    <!-- ===================== Base ===================== -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource FondoBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
    </Style>

    <Style x:Key="TextoAyuda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ===================== Contenedores ===================== -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ===================== Botones ===================== -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AcentoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoSuaveBrush}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Foreground" Value="{StaticResource PeligroBrush}"/>
    </Style>

    <!-- Boton de la barra lateral -->
    <Style x:Key="BotonNavegacion" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="4" Padding="12,9">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#EDEFF2"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoSuaveBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AcentoBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Campos ===================== -->
    <Style x:Key="CampoTexto" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Grillas ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SuperficieAlternaBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F0F2F5"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AcentoSuaveBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Avisos ===================== -->
    <Style x:Key="PanelError" TargetType="Border">
        <Setter Property="Background" Value="#FDECEA"/>
        <Setter Property="BorderBrush" Value="#F5C2BC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

</ResourceDictionary>
