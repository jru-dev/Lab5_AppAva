<UserControl x:Class="NeptunoApp.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Pedidos" Style="{StaticResource TituloSeccion}"/>
                <TextBlock Text="Cabecera del pedido y sus líneas de detalle."
                           Style="{StaticResource TextoAyuda}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Actualizar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding CargarCommand}" Margin="0,0,8,0"/>
                <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding EditarCommand}"
                        CommandParameter="{Binding Seleccionado}" Margin="0,0,8,0"/>
                <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                        Command="{Binding EliminarCommand}"
                        CommandParameter="{Binding Seleccionado}" Margin="0,0,8,0"/>
                <Button Content="Nuevo pedido" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Mensaje de error -->
        <Border Grid.Row="1" Style="{StaticResource PanelError}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource TextoToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource PeligroBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Cabeceras -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Pedidos}"
                          SelectedItem="{Binding Seleccionado}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="70"/>
                        <DataGridTextColumn Header="Fecha" Width="90"
                                            Binding="{Binding FechaPedido, StringFormat='dd/MM/yyyy'}"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="1.4*"/>
                        <DataGridTextColumn Header="Empleado" Binding="{Binding NombreEmpleado}" Width="1.1*"/>
                        <DataGridTextColumn Header="Transportista" Binding="{Binding NombreTransportista}" Width="1.1*"/>
                        <DataGridTextColumn Header="Destino" Binding="{Binding CiudadDestino}" Width="95"/>
                        <DataGridTextColumn Header="Envío" Width="90"
                                            Binding="{Binding FechaEnvio, StringFormat='dd/MM/yyyy'}"/>
                        <DataGridTextColumn Header="Total" Width="100"
                                            Binding="{Binding Total, StringFormat='N2'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No hay pedidos registrados."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource TextoAyuda}"
                           Visibility="{Binding HayRegistros, Converter={StaticResource BoolToVisibility},
                                        ConverterParameter=Invert}"/>
            </Grid>
        </Border>

        <!-- Barra del detalle -->
        <Grid Grid.Row="3" Margin="0,18,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Detalle del pedido" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding Seleccionado.PedidoID, StringFormat='  (#{0})'}"
                           Style="{StaticResource TextoAyuda}" Margin="4,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Editar línea" Style="{StaticResource BotonSecundario}"
                        Command="{Binding EditarDetalleCommand}"
                        CommandParameter="{Binding DetalleSeleccionado}" Margin="0,0,8,0"/>
                <Button Content="Quitar línea" Style="{StaticResource BotonPeligro}"
                        Command="{Binding EliminarDetalleCommand}"
                        CommandParameter="{Binding DetalleSeleccionado}" Margin="0,0,8,0"/>
                <Button Content="Agregar línea" Style="{StaticResource BotonPrimario}"
                        Command="{Binding AgregarDetalleCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Lineas -->
        <Border Grid.Row="4" Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid ItemsSource="{Binding Detalle}"
                      SelectedItem="{Binding DetalleSeleccionado}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                    <DataGridTextColumn Header="Precio" Width="100"
                                        Binding="{Binding PrecioUnidad, StringFormat='N2'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Descuento" Width="100"
                                        Binding="{Binding Descuento, StringFormat='P0'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Subtotal" Width="110"
                                        Binding="{Binding Subtotal, StringFormat='N2'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
