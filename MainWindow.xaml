<Window x:Class="WPF_SP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_SP"
        xmlns:models="clr-namespace:WPF_SP.Models"
        mc:Ignorable="d"
        Title="Mis Tareas" Height="720" Width="620" MinHeight="560" MinWidth="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Encabezado ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="19"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mis Tareas" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="TodoListDB · SQL Server" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Actualizar"
                    Command="{Binding CargarCommand}" VerticalAlignment="Center" FontSize="17"/>
        </Grid>

        <!-- ===== Formulario nueva tarea ===== -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Título" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NuevoTitulo, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="150" Margin="0,0,0,12"/>
                <TextBlock Text="Descripción (opcional)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NuevaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding AgregarCommand}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Agregar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Filtros ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton GroupName="Filtro" Style="{StaticResource FilterChip}" Content="Todas"
                         IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Todas}"/>
            <RadioButton GroupName="Filtro" Style="{StaticResource FilterChip}" Content="Pendientes" Margin="8,0,0,0"
                         IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Pendientes}"/>
            <RadioButton GroupName="Filtro" Style="{StaticResource FilterChip}" Content="Completadas" Margin="8,0,0,0"
                         IsChecked="{Binding CurrentFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Completadas}"/>
        </StackPanel>

        <!-- ===== Estado vacío ===== -->
        <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasTareas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="40"
                       Foreground="{StaticResource BorderBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No hay tareas por aquí" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ===== Lista de tareas ===== -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasTareas, Converter={StaticResource BoolToVisibility}}">
            <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Tareas}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Tarea}">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Completada}" Value="True">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}" IsChecked="{Binding Completada}"
                                          VerticalAlignment="Center" Margin="0,0,14,0"
                                          Command="{Binding DataContext.ToggleCompletadaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                               TextDecorations="{Binding Completada, Converter={StaticResource BoolToStrikethrough}}"/>
                                    <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Descripcion, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FechaCreacion, StringFormat='dd MMM yyyy HH:mm'}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Editar"
                                        Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="3" Style="{StaticResource DangerIconButton}" Content="&#xE74D;" ToolTip="Eliminar"
                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>
